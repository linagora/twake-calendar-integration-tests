{
  "webserver": {
    "baseUri": "/",
    "allowOrigin": "*",
    "realm": "ESN"
  },
  "amqp": {
    "host": "rabbitmq",
    "port": "5672",
    "login": "guest",
    "password": "guest",
    "vhost": "/",
    "sslEnabled": false,
    "sslTrustAllCerts": false
  },
  "database": {
    "esn": {
      "connectionString": "mongodb://mongo:27017/esn_docker",
      "connectionOptions": {
        "w": 1,
        "fsync": true,
        "connectTimeoutMS": 100000
      }
    },
    "sabre": {
      "connectionString": "mongodb://mongo:27017/sabre",
      "connectionOptions": {
        "w": 1,
        "fsync": true,
        "connectTimeoutMS": 100000
      }
    }
  },
  "esn": {
    "apiRoot": "http://twake-calendar-side-service:8080",
    "calendarRoot": "http://twake-calendar-side-service:8080/calendar/api"
  },
  "environment": {
    "SABRE_ENV": "dev",
    "LDAP_SERVER": "ldap://esn_ldap:389",
    "LDAP_BASE": "ou=users,dc=open-paas.org,dc=lng",
    "LDAP_ADMIN_DN": "cn=admin,dc=open-paas.org,dc=lng",
    "LDAP_ADMIN_PASSWORD": "admin",
    "LDAP_USERNAME_MODE": "username",
    "SABRE_ADMIN_LOGIN": "admin",
    "SABRE_ADMIN_PASSWORD": "secret123",
    "SABRE_IMPERSONATION_ENABLED": true,
    "SABRE_EMAIL_VALARM_RECIPIENT_SCHEDULING": true,
    "LOG_TRACE": true,
    "PRINCIPAL_PRIVACY": false
  }
}
